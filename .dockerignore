# Deny everything, then allow only what the build needs. This keeps secrets and
# state out of the build context for good: .env*, *.db, any *.toml config or
# *.key, .git and bin/dist never reach the builder.
*
!go.mod
!go.sum
!LICENSE
!cmd/
!cmd/**
!internal/
!internal/**
# Even inside the allowed trees, never send these.
**/*.db
**/*.db-*
**/*.toml
**/*.key
**/.env*
**/*_test.go
**/testdata
