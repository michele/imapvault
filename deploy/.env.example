# Copy to .env next to docker-compose.yml (`cp .env.example .env`). No secrets here.

# The account name: it picks config/<name>.toml. Letters, digits, '-' and '_'.
IMAPVAULT_ACCOUNT=fastmail

# uid/gid the container runs as. Use the owner of secrets/imap_password and repo/ on the host:
# run `id` as that user on the NAS (Synology users often start at 1026).
PUID=65532
PGID=65532

# Time zone for the times imapvault prints (snapshots, alerts). An IANA name such as Europe/Rome.
TZ=UTC

# Image to run. Pin a version once the first backup works, so an update is a decision you take
# (see docs/DEPLOY.md, "Updating"). A locally built image (make docker-build) is imapvault:local.
IMAPVAULT_IMAGE=ghcr.io/michele/imapvault:latest

# What `docker compose up -d` (the `run` service) does and when. Intervals: 15m, 1h, 24h, 7d; 0 turns one off.
# Backing up more often than hourly gains little: each run writes a copy of the index, and the mass-deletion
# guard compares every run with the one before, so a slow deletion spread over many runs stays under its limits.
IMAPVAULT_EVERY=1h
# Mark snapshots the retention policy no longer keeps. It deletes nothing.
IMAPVAULT_FORGET_EVERY=24h
# Delete what no kept snapshot needs once the grace period has passed. Off by default: turn it on
# (e.g. 7d) when you are happy with `docker compose run --rm prune --dry-run`. Needs FORGET_EVERY.
IMAPVAULT_PRUNE_EVERY=0
# Send one notification when no backup has succeeded for this long (see guard.on_alert_url in the config).
IMAPVAULT_STALE_AFTER=24h
