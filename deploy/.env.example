# Copy to .env next to docker-compose.yml (`cp .env.example .env`). No secrets here.

# The account name: it picks config/<name>.toml. Letters, digits, '-' and '_'.
IMAPVAULT_ACCOUNT=fastmail

# uid/gid the container runs as. Use the owner of secrets/imap_password and repo/ on the host:
# run `id` as that user on the NAS (Synology users often start at 1026).
PUID=65532
PGID=65532

# Time zone for the times imapvault prints (snapshots, alerts). An IANA name such as Europe/Rome.
TZ=UTC

# Image to run. Pin a version once the first backup works, so an update is a decision you take
# (see docs/DEPLOY.md, "Updating"). A locally built image (make docker-build) is imapvault:local.
IMAPVAULT_IMAGE=ghcr.io/michele/imapvault:latest
